# Reference list of Worker secret NAMES only. Do not create a filled-in copy.
# Secrets are entered once per client, directly as Cloudflare Worker secrets
# (dashboard, or interactive `node scripts/with-client.mjs --client <client.json> -- secret put NAME`).
# See docs/superpowers/specs/2026-11-26-per-client-deployment-design.md §5.5.

API_KEY=your-api-key
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
WORKER_URL=https://ai-line-crm.takanorixai.workers.dev
LIFF_URL=https://liff.line.me/your-liff-id

# Optional provider keys. Set at least one before enabling AI concierge.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional integrations
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
MEET_CALLBACK_SECRET=your-meet-callback-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# MCP / harness client
LINE_HARNESS_API_URL=https://ai-line-crm.takanorixai.workers.dev
LINE_HARNESS_API_KEY=your-api-key
