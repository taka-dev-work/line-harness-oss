{
  "name": "line-oss-crm",
  "version": "0.13.1",
  "private": true,
  "description": "Open-source LINE Official Account CRM/marketing automation",
  "scripts": {
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker run deploy",
    "deploy:worker:production": "NEXT_PUBLIC_API_URL= pnpm --filter web build && pnpm --filter worker run build && pnpm exec wrangler deploy --config apps/worker/wrangler.toml --env production",
    "secrets:sync:production": "node scripts/sync-worker-secrets-from-env.mjs --env-file .env.production --env production",
    "deploy:web": "pnpm --filter web build",
    "db:migrate": "wrangler --config apps/worker/wrangler.toml d1 execute DB --env production --remote --file=packages/db/schema.sql",
    "db:migrate:local": "wrangler --config apps/worker/wrangler.toml d1 execute DB --local --file=packages/db/schema.sql",
    "crm:validate:ai-line": "node scripts/validate-ai-line-crm-blueprint.mjs",
    "crm:check:ai-line": "node scripts/check-ai-line-crm-readiness.mjs",
    "crm:seed:ai-line": "node scripts/apply-ai-line-crm-blueprint.mjs",
    "crm:rich-menu:ai-line": "node scripts/export-ai-line-crm-rich-menu.mjs",
    "deploy:setup": "node packages/create-line-harness/dist/index.js",
    "deploy:update": "node packages/create-line-harness/dist/index.js update"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "4"
  }
}
