# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Admin API Key (generate a random string)
API_KEY=your_api_key_here

# Workers API URL (set after deploying worker)
NEXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev

# AI concierge provider keys (set as Cloudflare Secrets; leave blank locally)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional AI concierge models (non-secret)
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash

# External webhook secrets (set as Cloudflare Secrets)
MEET_CALLBACK_SECRET=
STRIPE_WEBHOOK_SECRET=
